      "cell_type": "code",
      "source": [
        "item = input(\"Item: \")\n",
        "price = float(input(\"Price: \"))\n",
        "quantity = int(input(\"Quantity: \"))\n",
        "member = input(\"Member (yes/no): \")\n",
        "\n",
        "if price <= 0 or quantity <= 0:\n",
        "    print(\"Error: Price and quantity must be greater than 0.\")\n",
        "else:\n",
        "    subtotal = price * quantity\n",
        "\n",
        "    if subtotal >= 5000:\n",
        "        discount_rate = 10\n",
        "    elif subtotal >= 2000:\n",
        "        discount_rate = 5\n",
        "    else:\n",
        "        discount_rate = 0\n",
        "\n",
        "    if member == \"yes\":\n",
        "        discount_rate += 2\n",
        "\n",
        "    discount = subtotal * discount_rate / 100\n",
        "    after_discount = subtotal - discount\n",
        "\n",
        "    gst = after_discount * 18 / 100\n",
        "    amount = after_discount + gst\n",
        "\n",
        "    if amount > 1000:\n",
        "        delivery = 0\n",
        "        delivery_text = \"Free\"\n",
        "    else:\n",
        "        delivery = 50\n",
        "        delivery_text = \"50.00\"\n",
        "\n",
        "    total = amount + delivery\n",
        "\n",
        "    print(\"\\n------ BILL ------\")\n",
        "    print(f\"Item        : {item}\")\n",
        "    print(f\"Subtotal    : {subtotal:.2f}\")\n",
        "    print(f\"Discount    : {discount:.2f}   ({discount_rate}%)\")\n",
        "    print(f\"GST (18%)   : {gst:.2f}\")\n",
        "    print(f\"Delivery    : {delivery_text}\")\n",
        "    print(f\"TOTAL       : {total:.2f}\")\n",
